  "r-ext11-001": {
    "category": "READINGS",
    "identity": [
      "二つの入口",
      "私はどこから入りましたか。",
      "友達に会う前に、何をしますか。"
    ]
  },
  "r-ext11-002": {
    "category": "READINGS",
    "identity": [
      "昼ご飯のメモ",
      "もう一つのおにぎりは誰のですか。",
      "みかんはいつ食べますか。"
    ]
  },
  "r-ext11-003": {
    "category": "READINGS",
    "identity": [
      "店の新しい時間",
      "今週、店は何時に閉まりますか。",
      "私は店に着いて、パンを買えますか。"
    ]
  },
  "r-ext11-004": {
    "category": "READINGS",
    "identity": [
      "予約を変える",
      "今の予約はいつですか。",
      "友達に連絡した理由は何ですか。"
    ]
  },
  "r-ext11-005": {
    "category": "READINGS",
    "identity": [
      "返す場所",
      "受付が閉まっている場合、どうすればいいですか。",
      "私は傘を入れた後、何をしましたか。"
    ]
  },
  "r-ext11-006": {
    "category": "READINGS",
    "identity": [
      "短い復習",
      "疲れた日はどうしますか。",
      "毎日の数を増やさないのはなぜですか。"
    ]
  },
  "r-ext11-007": {
    "category": "READINGS",
    "identity": [
      "写真の整理",
      "整理の途中で何を変えたか。",
      "作者は容量の問題をどう考えているか。"
    ]
  },
  "r-ext11-008": {
    "category": "READINGS",
    "identity": [
      "会議の記録",
      "短い記録にも残すものは何か。",
      "詳しいメモを残す目的は何か。"
    ]
  },
  "r-ext11-009": {
    "category": "READINGS",
    "identity": [
      "受け取り方を選ぶ",
      "店で受け取る主な理由は何か。",
      "作者が評価している点は何か。"
    ]
  },
  "r-ext11-010": {
    "category": "READINGS",
    "identity": [
      "数値の見せ方",
      "件数が増えたことだけでは成果を判断できない理由は何か。",
      "筆者の主張に最も近いものはどれか。"
    ]
  },
  "r-ext11-011": {
    "category": "READINGS",
    "identity": [
      "静かな席",
      "一部で試す理由として最も適切なものは何か。",
      "意見を聞くときに重視するのは何か。"
    ]
  },
  "r-ext11-012": {
    "category": "READINGS",
    "identity": [
      "無料という条件",
      "筆者は有料サービスをどう捉えているか。",
      "「出口」が指すものは何か。"
    ]
  },
  "r-ext11-013": {
    "category": "READINGS",
    "identity": [
      "記録されない待ち時間",
      "筆者が問題視しているのは何か。",
      "途中で諦めた人に触れた意図は何か。",
      "数字と聞き取りの関係として適切なのはどれか。"
    ]
  },
  "r-ext11-014": {
    "category": "READINGS",
    "identity": [
      "二つの貸出案内",
      "十九日に練習するには、いつまでに交流室へ申し込む必要があるか。",
      "返却について正しいものはどれか。",
      "営利目的の許可について適切な判断はどれか。"
    ]
  },
  "r-ext11-015": {
    "category": "READINGS",
    "identity": [
      "分かりやすさの先に",
      "筆者が短い説明に求める条件は何か。",
      "暗唱より具体的な行動を尋ねるのはなぜか。",
      "別の資料に置ける場合がある情報はどれか。"
    ]
  },
  "r14-0": {
    "category": "READINGS",
    "identity": [
