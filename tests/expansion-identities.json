  "u-t12-00": {
    "category": "usage",
    "identity": "问「誰が窓を開けましたか」时，突出“是我”应选？"
  },
  "u-t12-01": {
    "category": "usage",
    "identity": "“用日语写信”中的语言工具应如何标记？"
  },
  "u-t12-02": {
    "category": "usage",
    "identity": "要求“17点之前某时交完材料”，应选？"
  },
  "u-t12-03": {
    "category": "usage",
    "identity": "“昨天买的书”在礼貌句中应写？"
  },
  "u-t12-04": {
    "category": "usage",
    "identity": "要表达“回家以后请联系”，最直接的是？"
  },
  "u-t12-05": {
    "category": "usage",
    "identity": "转述朋友“这家店好吃”的信息，应选？"
  },
  "u-t12-06": {
    "category": "usage",
    "identity": "「この本は多くの人に読まれています」主要是什么用法？"
  },
  "u-t12-07": {
    "category": "usage",
    "identity": "以“我”为主语说“请老师修改作文”，应选？"
  },
  "u-t12-08": {
    "category": "usage",
    "identity": "说明“为了明早使用，先打印好资料”最合适的是？"
  },
  "u-t12-09": {
    "category": "usage",
    "identity": "“即使不想去，因已承诺而不能缺席”对应？"
  },
  "u-t12-10": {
    "category": "usage",
    "identity": "“为了让后排也听得见，大声说明”，宜选？"
  },
  "u-t12-11": {
    "category": "usage",
    "identity": "「全員が反対したわけではない」能确定什么？"
  },
  "u-t12-12": {
