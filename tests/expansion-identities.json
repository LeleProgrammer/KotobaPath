  "t12-00": {
    "category": "topics",
    "identity": "は与が：先区分话题和焦点"
  },
  "t12-01": {
    "category": "topics",
    "identity": "に与で：存在、活动、结果和工具"
  },
  "t12-02": {
    "category": "topics",
    "identity": "时间表达：时点、长度、期限"
  },
  "t12-03": {
    "category": "topics",
    "identity": "词典形、普通形与敬体不是同一个概念"
  },
  "t12-04": {
    "category": "topics",
    "identity": "と、ば、たら、なら：按事件顺序选条件"
  },
  "t12-05": {
    "category": "topics",
    "identity": "そう、よう、らしい：证据来源与接续"
  },
  "t12-06": {
    "category": "topics",
    "identity": "受身、可能、尊敬：同形要放回句子"
  },
  "t12-07": {
    "category": "topics",
    "identity": "授受：把动作执行者和受益者画清"
  },
  "t12-08": {
    "category": "topics",
    "identity": "自动词他动词与ている、てある、ておく"
  },
  "t12-09": {
    "category": "topics",
    "identity": "はず、べき、わけ：预期、规范与解释"
  },
  "t12-10": {
    "category": "topics",
    "identity": "目的：ために与ように的控制关系"
  },
  "t12-11": {
    "category": "topics",
    "identity": "部分否定：否定的是范围还是全部"
  },
  "t12-12": {
    "category": "topics",
    "identity": "时间从句：た形不总等于过去"
  },
  "t12-13": {
    "category": "topics",
    "identity": "にとって、に対して、について：别让中文“对”误导"
  },
  "t12-14": {
    "category": "topics",
    "identity": "得る、かねる、かねない：形式相似但方向相反"
  },
  "t12-15": {
    "category": "topics",
    "identity": "次第：立即、取决于、缘由三分法"
  },
  "t12-16": {
    "category": "topics",
    "identity": "あげく与末に：过程终点的评价"
  },
  "t12-17": {
    "category": "topics",
    "identity": "だけ、しか、にすぎない：限制不等于否定存在"
  },
  "t12-18": {
    "category": "topics",
    "identity": "がてら、かたわら、かたがた：目的与持续尺度"
  },
  "t12-19": {
    "category": "topics",
    "identity": "ずにはいられない、ずにはおかない、ずにはすまない"
  },
  "t12-20": {
    "category": "topics",
    "identity": "ところで、たところ、たところで：形似不等义"
  },
  "t12-21": {
    "category": "topics",
    "identity": "だらけ、まみれ、ずくめ：不要只背“全是”"
  },
  "t12-22": {
    "category": "topics",
    "identity": "论说文：作者结论、让步与限制条件"
  },
